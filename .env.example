# --- Sanity (blogs & events) ---------------------------------------------
# From sanity.io/manage → your project. Public: these only allow reading published content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# --- Resend (enquiry form) -----------------------------------------------
# Server-only. Create at resend.com/api-keys with "Sending access".
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Nadrix Website <website@nadrixsolutions.com>"
ENQUIRY_FROM="Nadrix Website <website@nadrixsolutions.com>"
# Where enquiries go, per team picked in the form
ENQUIRY_TO_SALES=sales@nadrixsolutions.com
ENQUIRY_TO_TECHNICAL=pandurang.patole@nadrixsolutions.com

# --- Site -----------------------------------------------------------------
SITE_URL=https://www.nadrixsolutions.com
