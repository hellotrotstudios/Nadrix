---
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  current?: NavKey;
  headerRule?: boolean;
  /** Absolute or root-relative image for social previews */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, current = 'home', headerRule = false, ogImage, ogType = 'website' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={canonical}>}
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {ogImageUrl && <meta property="og:image" content={ogImageUrl}>}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <slot name="head" />
</head>
<body>

  <Header current={current} rule={headerRule} />

  <main id="top">
    <slot />
  </main>

  <Footer home={current === 'home'} />

  <script is:inline src="/js/main.js"></script>
</body>
</html>
